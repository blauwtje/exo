#!/bin/sh
# why: git runs this hook on every ref update, and --no-verify does not skip it.
updates=$(cat)
[ "$1" = prepared ] || exit 0
here=$(cd "$(git rev-parse --path-format=absolute --git-common-dir)" && pwd -P) || exit 0
[ "$here" = "$EXO_RUN_GIT_DIR" ] || exit 0
checkpoints=$(printf '%s\n' "$updates" | while read -r old new ref; do git log -1 --format=%B "$new" 2>/dev/null | grep -q '^Plan-checkpoint: ' && echo ok || echo no; done)
[ -n "$checkpoints" ] && ! printf '%s\n' "$checkpoints" | grep -q no && exit 0
echo 'exo run session: git refuses this ref update; the run script commits and lands each task after this session ends.' >&2
exit 1

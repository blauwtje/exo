{
  "modules": ["./run-watch.mjs"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || { printf '%s' '{\"systemMessage\":\"exo: Node 22 or newer not found, so exo safety hooks are off. Install Node 22+, then restart Claude Code.\"}'; exit 0; }; node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-bash.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-effort.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-edit.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|WebFetch|WebSearch|Skill|NotebookEdit|ToolSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; input=$(cat); [[ $input =~ \\\"tool_name\\\"[[:space:]]*:[[:space:]]*\\\"Web(Fetch|Search)\\\" && $input =~ [Rr][Ee][Dd]([Dd][Ii][Tt]|[Ll][Ii][Bb])|[Tt][Ee][Dd][Dd][Ii][Tt]|[\\\"[:space:]/]r/[A-Za-z0-9_] ]] || [[ -n $EXO_RUN_HANDOFF || $input =~ \\\"tool_name\\\"[[:space:]]*:[[:space:]]*\\\"(Read|Skill)\\\" ]] || { [[ $input =~ \\\"agent_id\\\"[[:space:]]*:[[:space:]]*\\\"([^\\\"]+)\\\" ]] && [ -e \"${TMPDIR:-/tmp}/exo-context-${BASH_REMATCH[1]//[^A-Za-z0-9_-]/_}\" ]; } || exit 0; exec <<<\"$input\"; node \"${CLAUDE_PLUGIN_ROOT}/hooks/context-limit.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; [ -n \"$EXO_RUN\" ] && [ -n \"$EXO_RUN_DIR\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-no-wait.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; [ -n \"$EXO_RUN\" ] && [ -n \"$EXO_RUN_DIR\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-no-wait.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

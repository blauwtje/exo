{
  "name": "exo",
  "version": "0.135.0",
  "description": "Claude Code plugin with four stages and hooks that refuse risky commands.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#attempt-fingerprint": "./lib/attempt-fingerprint.mjs",
    "#budgets": "./verify/budgets.mjs",
    "#check-cache": "./lib/check-cache.mjs",
    "#code-comments": "./lib/code-comments.mjs",
    "#code-rules": "./lib/code-rules.mjs",
    "#commit-text": "./lib/commit-text.mjs",
    "#config-directory": "./lib/config-directory.mjs",
    "#context-limits": "./lib/context-limits.mjs",
    "#default-options-home": "./lib/default-options-home.mjs",
    "#derivation": "./verify/checks/derivation.mjs",
    "#export-signatures": "./lib/export-signatures.mjs",
    "#hook-input": "./lib/hook-input.mjs",
    "#host": "./lib/host.mjs",
    "#land-gate": "./lib/land-gate.mjs",
    "#mcp-tool-call": "./lib/mcp-tool-call.mjs",
    "#memory-store": "./lib/memory-store.mjs",
    "#model-kinds": "./lib/model-kinds.mjs",
    "#on-path": "./harnesses/on-path.mjs",
    "#package-entry-point": "./lib/package-entry-point.mjs",
    "#page-chrome": "./lib/page-chrome.mjs",
    "#plan-tasks": "./lib/plan-tasks.mjs",
    "#run-decision": "./lib/run-decision.mjs",
    "#process-tree": "./lib/process-tree.mjs",
    "#confine-claude": "./lib/confine-claude.mjs",
    "#plugin-copy": "./lib/plugin-copy.mjs",
    "#red-green": "./lib/red-green.mjs",
    "#proofs-report": "./lib/proofs-report.mjs",
    "#prose-density": "./lib/prose-density.mjs",
    "#return-caps": "./verify/checks/return-caps.mjs",
    "#scratch-exclude": "./lib/scratch-exclude.mjs",
    "#scratch-path": "./lib/scratch-path.mjs",
    "#script-extensions": "./lib/script-extensions.mjs",
    "#script-flags": "./lib/script-flags.mjs",
    "#session-record-path": "./lib/session-record-path.mjs",
    "#settings-store": "./lib/settings-store.mjs",
    "#size-facts": "./lib/size-facts.mjs",
    "#stall-guard": "./lib/stall-guard.mjs",
    "#suite-command": "./lib/suite-command.mjs",
    "#token-weights": "./lib/token-weights.mjs"
  },
  "repository": "https://github.com/blauwtje/exo",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node verify.mjs",
    "validate:static": "node verify.mjs --static",
    "test": "node --import ./tests/clean-run-env.mjs --test --test-concurrency=2 \"tests/*.test.mjs\"",
    "smoke": "bash tests/smoke.sh",
    "check": "node verify.mjs",
    "bump": "node bump.mjs",
    "release-pending": "node release-pending.mjs",
    "release-notes": "node release-notes.mjs",
    "models": "node verify/model-kinds.mjs",
    "generate": "node harnesses/codex/generate.mjs",
    "overlap": "node verify/phrase-overlap.mjs"
  }
}

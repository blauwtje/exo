{
  "name": "exo",
  "version": "1.1.0",
  "description": "Claude Code plugin with skills for specs, proof-first builds, diagnosis and shipping.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#basics": "./scripts/lib/basics.mjs",
    "#git": "./scripts/lib/git.mjs",
    "#script-flags": "./scripts/lib/script-flags.mjs",
    "#shared-values": "./scripts/lib/shared-values.mjs"
  },
  "repository": "https://github.com/blauwtje/exo",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:static": "node scripts/verify.mjs --static",
    "test": "node --import ./tests/clean-run-env.mjs --test --test-concurrency=2 \"tests/*.test.mjs\"",
    "check": "npm test && node scripts/verify.mjs",
    "bump": "node scripts/bump.mjs",
    "release-pending": "node scripts/release-pending.mjs",
    "release-notes": "node scripts/release-notes.mjs"
  }
}

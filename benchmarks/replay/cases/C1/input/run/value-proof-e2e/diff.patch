diff --git a/src/render.mjs b/src/render.mjs
index 783bead..4991a5c 100644
--- a/src/render.mjs
+++ b/src/render.mjs
@@ -17,3 +17,11 @@ export function renderText(summary, { top = null } = {}) {
   lines.push(`${'Total'.padEnd(width)}  ${String(summary.reduce((n, entry) => n + entry.count, 0)).padStart(5)}  ${formatAmount(grand).padStart(12)}`);
   return `${lines.join('\n')}\n`;
 }
+
+// The JSON report: one { category, count, total } object per shown category,
+// totals rounded to cents like the text report.
+export function renderJson(summary, { top = null } = {}) {
+  const shown = top === null ? summary : summary.slice(0, top);
+  const entries = shown.map(({ category, count, total }) => ({ category, count, total: Math.round(total * 100) / 100 }));
+  return `${JSON.stringify(entries, null, 2)}\n`;
+}

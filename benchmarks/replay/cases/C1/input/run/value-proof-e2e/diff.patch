+
+async function run(argv, input) {
+  let stdout = '';
+  let stderr = '';
+  const io = {
+    stdout: { write: (s) => { stdout += s; } },
+    stderr: { write: (s) => { stderr += s; } },
+    stdin: [input]
+  };
+  const code = await main(argv, io);
+  return { code, stdout, stderr };
+}
+
+const CSV = 'date,category,description,amount\n2024-07-01,Food,a,0.10\n2024-07-02,Food,b,0.20\n2024-07-03,Travel,c,1000\n2024-07-04,Rent,d,500\n';
+
+test('--format json prints one object per category', async () => {
+  const { code, stdout } = await run(['-', '--format', 'json'], CSV);
+  assert.equal(code, 0);
+  assert.deepEqual(JSON.parse(stdout), [
+    { category: 'Travel', count: 1, total: 1000 },
+    { category: 'Rent', count: 1, total: 500 },
+    { category: 'Food', count: 2, total: 0.3 }
+  ]);
+});
+
+test('--format json honors --sort, --top and --category', async () => {
+  assert.deepEqual(JSON.parse((await run(['-', '--format=json', '--sort', 'name', '--top', '2'], CSV)).stdout).map((e) => e.category), ['Food', 'Rent']);
+  assert.deepEqual(JSON.parse((await run(['-', '--format=json', '--category', 'food'], CSV)).stdout), [{ category: 'Food', count: 2, total: 0.3 }]);
+  assert.deepEqual(JSON.parse((await run(['-', '--format=json', '--category', 'none'], CSV)).stdout), []);
+});
+
+test('--format text keeps the text report', async () => {
+  assert.equal((await run(['-', '--format', 'text'], CSV)).stdout, (await run(['-'], CSV)).stdout);
+});
+
+test('unknown --format exits 2', async () => {
+  const { code, stdout, stderr } = await run(['-', '--format', 'xml'], CSV);
+  assert.equal(code, 2);
+  assert.equal(stdout, '');
+  assert.equal(stderr, 'expenses: --format must be one of text, json\n');
 });

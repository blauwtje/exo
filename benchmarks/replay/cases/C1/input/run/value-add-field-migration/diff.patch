diff --git a/src/db/migrations/10_invoice_currency.mjs b/src/db/migrations/10_invoice_currency.mjs
new file mode 100644
index 0000000..c7b80f4
--- /dev/null
+++ b/src/db/migrations/10_invoice_currency.mjs
@@ -0,0 +1,12 @@
+import { currencyOf } from '../../models/account.mjs';
+
+export const description = 'invoices carry the currency of their account';
+
+export function up(db) {
+  for (const invoice of db.invoices) {
+    if (invoice.currency) continue;
+    const account = db.accounts.find((candidate) => candidate.id === invoice.accountId);
+    const org = account && db.orgs.find((candidate) => candidate.id === account.orgId);
+    invoice.currency = account && org ? currencyOf(account, org) : null;
+  }
+}

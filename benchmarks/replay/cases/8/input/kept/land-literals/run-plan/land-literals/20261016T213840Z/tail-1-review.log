root, planPath);\n   const block = commitBlockOf(plan, number, planId, signatureChanges(task, root), root);\n   refuseBadCommitText(task.commitSubject ?? task.title, block);\n   const { proofCommand, pending } = checkReport(task, reportText, reportPath);\ndiff --git a/skills/spec/references/task-list.md b/skills/spec/references/task-list.md\nindex 49ee98f4..b443570c 100644\n--- a/skills/spec/references/task-list.md\n+++ b/skills/spec/references/task-list.md\n@@ -22,7 +22,7 @@\n ```\n ### Task <n>: <type>(<scope>): <subject>\n \n-Depends on: none | <n>[, <n>] | Files: `<path>`[, `<path>`] | Data: <structure, one clause>[ | Design: <skill name>][ | Risk: <category>][ | Red: none (<reason>)] | Proof: <one command>\n+Depends on: none | <n>[, <n>] | Files: `<path>`[, `<path>`] | Data: <structure, one clause>[ | Design: <skill name>][ | Risk: <category>][ | Red: none (<reason>)][ | Literals: none (<reason>)] | Proof: <one command>\n ```\n \n - `Files:` ending `/` → whole folder.\ndiff --git a/tests/land-task-commit.test.mjs b/tests/land-task-commit.test.mjs\nindex d65f3605..369acdbd 100644\n--- a/tests/land-task-commit.test.mjs\n+++ b/tests/land-task-commit.test.mjs\n@@ -189,6 +189,25 @@ test('the command line lands a task, and a refusal leaves stdout empty', async (\n   assert.match(noTrailer.stderr, /Plan-task: 2/);\n });\n \n+const literalPlan = (data, escape = '') => compactPlanFixture({ tasks: [\n+  `${compactTask({ number: 1, title: 'feat(app): greet', files: ['src/app.js'], data, proof: 'node tests/app.test.mjs' })}${escape}`\n+] }).replace('## Plan basis\\n', '## Plan basis\\nLand gate: true\\n');\n+\n+test('a Data literal found nowhere in the change or the tree is refused, naming the string and the escape', async () => {\n+  const { root, planPath } = await compactCheckout(literalPlan('names `zzqq_absent_literal` and `greet`'));\n+  await writeReport(root, PASS_REPORT);\n+  await assertRefused(root, planPath, [], /Data: names `zzqq_absent_literal`, .*Literals: none \\(<reason>\\)/);\n+});\n+\n+test('a Data literal that is present, a path with a line suffix, a placeholder form or an escaped task lands', async () => {\n+  const data = 'names `greet`, `src/app.js:1-2` and `greet(<arg>)`';\n+  const present = await compactCheckout(literalPlan(data));\n+  assert.match(landTask({ planPath: present.planPath, planText: literalPlan(data), number: 1, root: present.root, reportText: PASS_REPORT }), /^Committed: [0-9a-f]+ Task 1$/m);\n+  const escapedPlan = literalPlan('names `zzqq_absent_literal`', ' | Literals: none (prose)');\n+  const escaped = await compactCheckout(escapedPlan);\n+  assert.match(landTask({ planPath: escaped.planPath, planText: escapedPlan, number: 1, root: escaped.root, reportText: PASS_REPORT }), /^Committed: [0-9a-f]+ Task 1$/m);\n+});\n+\n test('a test-first task whose change touches no test file is refused before anything commits', async () => {\n   const plan = compactPlanFixture({ tasks: [\n     compactTask({ number: 1, title: 'fix(app): greet', files: ['src/app.js', 'tests/app.test.mjs'], proof: 'node tests/app.test.mjs' })\ndiff --git a/verify/budgets.mjs b/verify/budgets.mjs\nindex 8c610b60..40d420be 100644\n--- a/verify/budgets.mjs\n+++ b/verify/budgets.mjs\n@@ -71,10 +71,10 @@ export const REFERENCE_TOKEN_LOCKS = {\n   // autonomous-exo-5 Task 10; their older rules stay whole.\n   'skills/build/references/test-design.md': 921,\n   'skills/build/references/wave-worktrees.md': 928,\n-  'skills/build/run-task-prompt.md': 757,\n+  'skills/build/run-task-prompt.md': 789,\n   'skills/ship/references/pr-prep.md': 772,\n   'skills/spec/references/brief.md': 792,\n-  'skills/spec/references/task-list.md': 849,\n+  'skills/spec/references/task-list.md': 856,\n };\n // skills/route-skills/references/lean.md, read before every code edit, sits\n // under the 750 tokens REFERENCE_TOKEN_LOCKS starts at, so it is locked in\n","numLines":202,"startLine":1,"totalLines":202}},"tool_result_meta":[{"id":"toolu_01LaqFaCbFnMC
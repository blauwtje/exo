const BATCH_SIZE = 500;

function toBatches(entries) {
  const batches = [];
  for (let i = 0; i < entries.length; i += BATCH_SIZE) batches.push(entries.slice(i, i + BATCH_SIZE));
  return batches;
}

module.exports = { toBatches, BATCH_SIZE };


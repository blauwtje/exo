data 607
const config = require('../../config/default.json');
const { toBatches } = require('./batch');
const { withRetry } = require('./retry');
const ledger = require('../ledger-client');

async function runNightlySync(store) {
  const entries = await store.pendingEntries();
  for (const batch of toBatches(entries)) {
    await Promise.all(batch.map((entry) => withRetry(() => ledger.postEntry(entry), config.sync.maxAttempts)));
    await store.markSynced(batch.map((entry) => entry.id));
    await new Promise((resolve) => setTimeout(resolve, config.sync.pauseMs));
  }
}

module.exports = { runNightlySync };


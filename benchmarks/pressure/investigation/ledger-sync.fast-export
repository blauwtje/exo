const config = require('../config/default.json');

async function postEntry(entry) {
  const response = await fetch(`${config.ledger.baseUrl}/entries`, {
    method: 'POST',
    headers: { 'content-type': 'application/json', authorization: `Bearer ${process.env.LEDGER_TOKEN}` },
    body: JSON.stringify(entry)
  });
  if (!response.ok) {
    const error = new Error(`ledger responded ${response.status}`);
    error.status = response.status;
    throw error;
  }
  return response.json();
}

module.exports = { postEntry };


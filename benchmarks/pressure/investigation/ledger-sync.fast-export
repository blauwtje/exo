mark :9
data 571
const { primaryDb, replicaDb } = require('../db');

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

async function handleWebhook(event) {
  await primaryDb.insert('webhook_events', { id: event.id, payload: event });
  await sleep(2000);
  const invoice = await replicaDb.findOne('invoices', { externalId: event.data.invoiceId });
  if (!invoice) return { status: 'ignored' };
  await primaryDb.insert('pending_entries', { invoiceId: invoice.id, amount: event.data.amount });
  return { status: 'queued' };
}

module.exports = { handleWebhook };


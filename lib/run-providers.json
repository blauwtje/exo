{
  "efforts": ["low", "medium", "high", "xhigh", "max"],
  "defaults": { "provider": "claude", "effort": "medium", "capHeadroomTokens": 50, "contextLimit": 120000, "agentContextTarget": 60000, "bytesPerToken": 2, "fetchTokens": 1600, "imageTokenCap": 1600, "pdfPageTokens": 3000, "binaryReadTokens": 500, "searchLineBytes": 200, "toolSchemaBytes": 2048, "orchestratorWorkers": 4, "resultCapBytes": 4096, "orchestratorPredispatchReads": 4, "scriptBytes": 4096, "pruneAfterDays": 7, "promptCacheTtl": "5m", "turnOneCacheWriteWarn": 20000, "attemptCap": 4, "waveResolver": false, "improve": { "briefFileBytes": 12000, "noIdeaStop": 2, "inlineBytes": 4000, "outputLines": 5, "baselineRuns": 2, "maxRuns": 3, "keepZ": 1.96, "keepFloor": 0, "seed": 1, "caseMovers": 5, "holdoutMin": 8, "holdoutShare": 0.25 }, "eval": { "targetEffect": 0.03, "alpha": 0.05, "power": 0.8, "pairedCorrelation": 0.5, "calibrationMinLabels": 30, "calibrationKappaFloor": 0.6, "graduationRuns": 20, "realFailuresMin": 20 }, "tbench": { "limitUsd": 55, "trialUsd": 1.5 }, "sandbox": { "enabled": true, "allowedDomains": [] } },
  "providers": {
    "claude": {

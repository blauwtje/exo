{
  "provider": "claude",
  "providers": {
    "claude": {
      "models": ["fable", "opus", "sonnet", "haiku"],
      "tiers": { "strong": "opus", "standard": "sonnet", "fast": "haiku" },
      "efforts": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
    }
  },
  "budgets": {
    "lean": { "strong": "standard" }
  },
  "kinds": {
    "build": { "tier": "standard", "effort": "high" },
    "hardest": { "tier": "strong", "effort": "high" },
    "review": { "tier": "standard", "effort": "high" },
    "review-deep": { "tier": "strong", "effort": "high" },
    "review-deep-high": { "tier": "strong", "effort": "xhigh" },
    "investigate": { "tier": "standard", "effort": "high" },
    "coordinate": { "tier": "standard", "effort": "medium" },
    "research": { "tier": "standard", "effort": "medium" },
    "lookup": { "tier": "fast", "effort": null },
    "prose": { "tier": "strong", "effort": "high" },
    "chore": { "tier": "standard", "effort": "low" },
    "handover": { "tier": "inherit", "effort": null }
  },
  "stages": {
    "build-no-spec": { "kind": "hardest" },
    "build": { "kind": "coordinate" }
  },
  "agents": {
    "agents/build-task.md": { "kind": "build" },
    "agents/build-ui.md": { "kind": "build" },
    "agents/critique-ui.md": { "kind": "review-deep" },
    "agents/critique-ui-high.md": {
      "kind": "review-deep-high",
      "generatedFrom": "agents/critique-ui.md",
      "description": "Judges one built visual surface against its direction and writes the faults file. Dispatched by design-ui instead of critique-ui when the high budget is set. Not for a code review, a direction choice, or an unbuilt surface."
    },
    "agents/fetch-docs.md": { "kind": "research" },
    "agents/locate-code.md": { "kind": "lookup" },
    "agents/review-branch.md": { "kind": "review" },
    "agents/review-branch-deep.md": {
      "kind": "review-deep",
      "generatedFrom": "agents/review-branch.md",
      "description": "Reviews one finished plan branch above five files or 200 changed lines against its plan and the code standard, and writes a report. Dispatched by verify instead of review-branch for that size. Not for a smaller branch, a single task, a pull request or a diff without a plan."
    },
    "agents/review-branch-deep-high.md": {
      "kind": "review-deep-high",
      "generatedFrom": "agents/review-branch.md",
      "description": "Reviews one finished plan branch above five files or 200 changed lines against its plan and the code standard, and writes a report. Dispatched by verify instead of review-branch-deep when the high budget is set. Not for a smaller branch, a single task, a pull request or a diff without a plan."
    },
    "agents/run-unit.md": { "kind": "coordinate" },
    "agents/survey-ui.md": { "kind": "investigate" }
  },
  "skills": {
    "skills/build/SKILL.md": { "kind": "coordinate", "fields": ["effort"] },
    "skills/check-docs/SKILL.md": { "kind": "investigate", "fields": ["effort"] },
    "skills/configure/SKILL.md": { "kind": "chore", "fields": ["model"] },
    "skills/design-ui/SKILL.md": { "kind": "build", "fields": ["effort"] },
    "skills/file-issues/SKILL.md": { "kind": "prose", "fields": ["model", "effort"] },
    "skills/verify/SKILL.md": { "kind": "review", "fields": ["effort"] }
  },
  "dispatches": [
    { "file": "skills/build/bug-fixer-prompt.md", "match": "delegate on `opus` for a failed", "kind": "hardest" },
    { "file": "skills/build/drift-repairer-prompt.md", "match": "delegate on `opus` for a task that reported", "kind": "hardest" },
    { "file": "skills/build/review-fixer-prompt.md", "match": "delegate on `sonnet` when the branch review", "kind": "build" },
    { "file": "agents/run-unit.md", "match": "goes to an `opus` delegate", "kind": "hardest" },
    { "file": "skills/find-cause/SKILL.md", "match": "on `opus` from `investigator-prompt.md`", "kind": "hardest" },
    { "file": "skills/find-cause/SKILL.md", "match": "on `sonnet` from `fixer-prompt.md`", "kind": "build" },
    { "file": "skills/find-cause/investigator-prompt.md", "match": "delegate on `opus` for phase (b)", "kind": "hardest" },
    { "file": "skills/find-cause/fixer-prompt.md", "match": "delegate on `sonnet` for phase (c)", "kind": "build" },
    { "file": "skills/verify/SKILL.md", "match": "delegate on `sonnet` from `../build/review-fixer-prompt.md`", "kind": "build" }
  ]
}

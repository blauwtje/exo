{
  "provider": "claude",
  "providers": {
    "claude": {
      "models": ["fable", "opus", "sonnet", "haiku"],
      "tiers": { "deep": "opus", "strong": "opus", "standard": "sonnet", "fast": "haiku" },
      "efforts": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
    },
    "codex": {
      "models": ["gpt-6.1-sol", "gpt-6-luna"],
      "tiers": { "deep": "gpt-6.1-sol", "strong": "gpt-6.1-sol", "standard": "gpt-6.1-sol", "fast": "gpt-6-luna" },
      "efforts": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" },
      "effortShift": { "deep": 1, "strong": 1 },
      "nullEffort": "medium"
    },
    "deepseek": {
      "models": ["deepseek-flash"],
      "tiers": { "deep": "inherit", "strong": "inherit", "standard": "inherit", "fast": "inherit" },
      "efforts": { "low": "low", "medium": "high", "high": "high", "xhigh": "max", "max": "max" },
      "kindEfforts": { "build-task": "low", "doc-task": "low", "build": "low", "orchestrator": "low", "task-runner": "low", "judge": "low", "lookup": "low", "chore": "low", "fix-review": "high" }
    }
  },
  "kinds": {
    "build-task": {
      "on": { "tier": "standard", "effort": "low" },
      "retry": { "tier": "strong", "effort": "high" }
    },
    "doc-task": {
      "on": { "tier": "standard", "effort": "medium" },
      "retry": { "tier": "strong", "effort": "high" }
    },
    "build": {
      "on": { "tier": "standard", "effort": "low" }
    },
    "hardest": {
      "on": { "tier": "deep", "effort": "high" }
    },
    "build-repair": {
      "on": { "tier": "strong", "effort": "high" }
    },
    "improve-round": {
      "on": { "tier": "standard", "effort": "medium" }
    },
    "review": {
      "on": { "tier": "strong", "effort": "medium" }
    },
    "review-deep": {
      "on": { "tier": "deep", "effort": "high" }
    },
    "review-branch": {
      "on": { "tier": "strong", "effort": "medium" }
    },
    "fix-review": {
      "on": { "tier": "standard", "effort": "low" }
    },
    "investigate": {
      "on": { "tier": "standard", "effort": "high" }
    },
    "orchestrator": {
      "on": { "tier": "deep", "effort": "medium" }
    },
    "task-runner": {
      "on": { "tier": "standard", "effort": "medium" }
    },
    "research": {
      "on": { "tier": "standard", "effort": "medium", "ceiling": "high" }
    },
    "judge": {
      "on": { "tier": "fast", "effort": "low" }
    },
    "lookup": {
      "on": { "tier": "standard", "effort": "medium" }
    },
    "chore": {
      "on": { "tier": "standard", "effort": "medium" }
    },
    "peer": {
      "on": { "tier": "inherit", "effort": "high" }
    },
    "peer-review": {
      "on": { "tier": "inherit", "effort": "medium" }
    }
  },
  "unnamed": {
    "types": ["general-purpose", "claude"],
    "kind": "build",
    "jobs": {
      "review": "review", "verify": "review", "audit": "review", "judge": "review",
      "decide": "hardest", "design": "hardest", "choose": "hardest", "pick": "hardest",
      "cause": "hardest", "diagnose": "hardest", "architect": "hardest",
      "fix": "build", "repair": "build", "implement": "build", "build": "build",
      "investigate": "investigate", "research": "investigate", "summarise": "investigate", "summarize": "investigate", "explore": "investigate",
      "locate": "lookup", "find": "lookup", "lookup": "lookup",
      "rebase": "chore", "squash": "chore", "cleanup": "chore"
    }
  },
  "fetchSized": ["exo:research-worker"],
  "agents": {
    "agents/build-task.md": { "kind": "build-task", "labels": ["fix-review", "hardest", "build-repair"] },
    "agents/orchestrator.md": { "kind": "orchestrator" },
    "agents/research-worker.md": { "kind": "research" },
    "agents/review-branch.md": { "kind": "review-branch", "labels": ["review-deep", "judge"] },
    "agents/task-runner.md": { "kind": "task-runner" }
  },
  "dispatches": [
    { "file": "skills/build/references/worker-round.md", "match": "delegate whose prompt opens with `exo-kind: improve-round`", "kind": "improve-round" },
    { "file": "skills/find-cause/SKILL.md", "match": "the prompt opening with `exo-kind: build`", "kind": "build" },
    { "file": "skills/find-cause/fixer-prompt.md", "match": "delegate whose prompt opens with `exo-kind: build` for phase (c)", "kind": "build" },
    { "file": "skills/build/reviewer-prompt.md", "match": "delegate whose prompt opens with `exo-kind: peer-review`", "kind": "peer-review" },
    { "file": "skills/build/references/fresh-eyes.md", "match": "delegate whose prompt opens with `exo-kind: peer-review`", "kind": "peer-review" },
    { "file": "skills/build/references/design-tasks.md", "match": "delegate whose prompt opens with `exo-kind: peer`", "kind": "peer" },
    { "file": "skills/edit-skills/references/blind-eval.md", "match": "delegate whose prompt opens with `exo-kind: review` as judge", "kind": "review" },
    { "file": "skills/watch/SKILL.md", "match": "delegate whose prompt opens with `exo-kind: lookup`", "kind": "lookup" },
    { "file": "skills/build/references/design-ui.md", "match": "delegate whose prompt opens with `exo-kind: review` as critic", "kind": "review" }
  ]
}

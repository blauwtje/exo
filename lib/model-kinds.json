      "efforts": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
    },
    "codex": {
      "models": ["gpt-6.1-sol", "gpt-6-luna"],
      "tiers": { "strong": "gpt-6.1-sol", "standard": "gpt-6.1-sol", "fast": "gpt-6-luna" },
      "efforts": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" },
      "effortShift": { "strong": 1 },
      "nullEffort": "medium",
      "lowTwins": {
        "agents/critique-ui.md": "exo-critique-ui-low",
        "agents/review-branch-deep.md": "exo-review-branch-deep-low"
      }
    }
  },
  "budgets": {
    "low": { "strong": "standard" }
  },
  "kinds": {
    "build": { "tier": "standard", "effort": "high" },
    "hardest": { "tier": "strong", "effort": "high" },
    "review": { "tier": "standard", "effort": "high" },
    "review-deep": { "tier": "strong", "effort": "high" },
    "review-deep-high": { "tier": "strong", "effort": "xhigh" },
    "investigate": { "tier": "standard", "effort": "high" },
    "coordinate": { "tier": "standard", "effort": "medium" },
    "research": { "tier": "standard", "effort": "medium" },
    "lookup": { "tier": "fast", "effort": null },
    "prose": { "tier": "strong", "effort": "high" },
    "chore": { "tier": "standard", "effort": "low" },
    "hardest-high": { "tier": "strong", "effort": "xhigh" },
    "hardest-low": { "tier": "strong", "effort": "medium" },
    "handover": { "tier": "inherit", "effort": null }
  },
  "stages": {
    "build-no-spec": { "kind": "hardest" },
    "build": { "kind": "coordinate" }
  },
  "agents": {
    "agents/build-task.md": { "kind": "build" },
    "agents/build-ui.md": { "kind": "build" },
    "agents/critique-ui.md": { "kind": "review-deep" },
    "agents/critique-ui-high.md": {
      "kind": "review-deep-high",
      "generatedFrom": "agents/critique-ui.md",
      "description": "critique-ui, high budget, by name only."
    },
    "agents/fetch-docs.md": { "kind": "research" },
    "agents/fix-review.md": { "kind": "build" },
    "agents/locate-code.md": { "kind": "lookup" },
    "agents/review-branch.md": { "kind": "review" },
    "agents/review-branch-deep.md": {
      "kind": "review-deep",
      "generatedFrom": "agents/review-branch.md",
      "description": "Reviews one risky plan branch. Dispatched by verify only."
    },
    "agents/review-branch-deep-high.md": {
      "kind": "review-deep-high",
      "generatedFrom": "agents/review-branch.md",
      "description": "review-branch-deep, high budget, by name only."
    },
    "agents/run-unit.md": { "kind": "coordinate" },
    "agents/solve-hard.md": { "kind": "hardest" },
    "agents/solve-hard-high.md": {
      "kind": "hardest-high",

    },
    "agents/survey-ui.md": { "kind": "investigate" }
  },
  "skills": {
    "skills/build/SKILL.md": { "kind": "coordinate", "fields": ["effort"] },
    "skills/check-docs/SKILL.md": { "kind": "investigate", "fields": ["effort"] },
    "skills/configure/SKILL.md": { "kind": "chore", "fields": ["model"] },
    "skills/design-ui/SKILL.md": { "kind": "build", "fields": ["effort"] },
    "skills/file-issues/SKILL.md": { "kind": "prose", "fields": ["model", "effort"] },
    "skills/verify/SKILL.md": { "kind": "review", "fields": ["effort"] }
  },
  "dispatches": [
    { "file": "skills/find-cause/SKILL.md", "match": "on `sonnet` from `fixer-prompt.md`", "kind": "build" },
    { "file": "skills/find-cause/fixer-prompt.md", "match": "delegate on `sonnet` for phase (c)", "kind": "build" }
